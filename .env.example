# Copy to `.env.local` for local development.
# Keep real secrets and machine-specific database URLs out of version control.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/playbookai"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5433/playbookai_shadow"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-local-secret"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-local-secret"

# Providers
STORAGE_PROVIDER="local"
AI_PROVIDER="mock"

# Optional external providers
# ANTHROPIC_API_KEY="your-api-key"
